# Port exposed on the host machine (Docker) / port of the Vite dev server (pnpm dev)
FRONTEND_PORT=1488

# Runtime nginx reverse proxy to the backend API and Socket.IO.
# Leave empty to serve the frontend only (static SPA mode).
# Example for a backend container on the same Docker network:
# BACKEND_UPSTREAM=http://backend:8000
BACKEND_UPSTREAM=

# --- Build-time Vite variables (baked into the frontend bundle) ---

# Leave empty when using BACKEND_UPSTREAM nginx proxy (recommended for Docker).
# Set to an absolute backend URL only when the API is on a different origin.
VITE_BACKEND_ORIGIN=

VITE_TWITCH_CLIENT_ID=
VITE_KICK_CLIENT_ID=
VITE_VK_VIDEO_LIVE_CLIENT_ID=
VITE_DONATEX_CLIENT_ID=
VITE_TMDB_API_KEY=
VITE_METADATA_WORKER_URL=
VITE_KINOPOISK_METADATA_WORKER_URL=
VITE_DOCS_BASE_URL=/docs

VITE_ERROR_TRACKING_PROVIDER=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_GLITCHTIP_DSN=
VITE_GLITCHTIP_ENVIRONMENT=

VITE_GOOGLE_TAG_MANAGER_CONTAINER_ID=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
